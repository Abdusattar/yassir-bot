start.sh
*.db
venv/
__pycache__/
*.pyc
*.pyo
.env
# Все варианты файла с ключами: .env.female, .env.bak-* (14.11.2026 - .env.female не был
# в списке и висел «неотслеживаемым» на сервере; репо публичный).
.env.*
!.env.example
bot.log
nohup.out

# Сырые данные для сборки БД (см. scripts/build_*.py) — большие, регенерируемые
sources/*

# Исключение: матны учебной программы (нахв/таджвид) — маленькие (13 и 6 КБ),
# общественное достояние, и по ним сверяются цитаты в уроках. Раньше цитаты
# каждый раз добывались поиском по вебу заново — см. wiki/curriculum.md.
!sources/matn/
# «Сорок хадисов» по фразам (архив ar-ru.ru, сайта больше нет) и запасной
# текст - источник core/arbain.json.gz, второй раз их может быть негде взять.
!sources/arbain/

# Старая альфа/MVP версия — держим для сверки, не в git
yassir_bot_38/

# Рабочие файлы устаза (голосовые, черновики)
устаз/

# Реальные голосовые студентов/устазов — тестовые примеры для ИИ-исследования
audio/

# Скриншоты
Снимок*.PNG

# Личные локальные настройки Claude Code
.claude/settings.local.json
.aider*

# Сгенерированные данные мусхаф-страниц (scripts/export_mushaf_page.py) -
# регенерируются из mufradat_words, не нужны в истории git
mushaf_data/*.json
# ...но manifest.json написан руками, а не сгенерирован: это часть
# приложения (значок на экране телефона, 10.09.2026), она обязана ехать
# в git и на сервер вместе с index.html.
!mushaf_data/manifest.json
# Пословные переводы по сурам (14.11.2026, scripts/build_wbw_chunks.py) - собираются
# из базы на сервере, источник - mufradat_words, не git.
mushaf_data/wbw/*/
mushaf_data/wbw/manifest.json

# Кэш HTML печатной раскладки KFGQPC V4 из QUL (scripts/fix_mushaf_lines.py) -
# 97 МБ скачанных превью, нужен только для перезапуска починки разметки.
qul_cache/

# Аудит раскладки мусхафа (пересоздаётся scripts/audit_mushaf_layout.py)
sources/layout_audit.json
sources/qul_layout_cache/

# Яссир Медиа: тяжёлые файлы роликов не в git
media/**/*.mp4
media/**/*.wav
media/**/*.mp3
media/**/*.png
core/nahw_corpus-*.db

# Записи студентов для проверки качества - только локально, не в git (19.10.2026)
logs/audio_checks/

# Записи студентов и голос устаза для R&D таджвида - репо публичный (11.11.2026)
tajweed_ai/data/umar_corpus/
tajweed_ai/data/_*.log
tajweed_ai/data/hear_emb/
tajweed_ai/data/hear_results.jsonl
tajweed_ai/data/hear_marked_ids.txt

# отметка «какие джузы пословного ru загружены в базу» (scripts/check_wbw_ru_loaded.py) - у каждой машины своя
.wbw_ru_loaded.json
