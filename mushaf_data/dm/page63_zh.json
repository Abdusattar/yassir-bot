个火坑的边缘上的，是他〔安拉〕使你们脱离那个火坑。安拉如此为你们阐明他的迹象，以便你们遵循正道。"},{"surah":3,"ayah":104,"tokens":[{"type":"word","html":"وَلْتَك<tajweed class=idgham_ghunnah>ُن</tajweed>","position":1,"translation":"让有","code_v4":"ﲆ"},{"type":"word","html":"<tajweed class=idgham_ghunnah>م</tajweed>ِّ<tajweed class=ikhafa>نك</tajweed>ُمْ","position":2,"translation":"你们中","code_v4":"ﲇ"},{"type":"word","html":"أُ<tajweed class=ghunnah>مّ</tajweed>َ<tajweed class=idgham_ghunnah>ةٌ</tajweed>","position":3,"translation":"一部分人","code_v4":"ﲈ"},{"type":"word","html":"<tajweed class=idgham_ghunnah>ي</tajweed>َ<tajweed class=qalaqah>دْ</tajweed>عُونَ","position":4,"translation":"他们召唤","code_v4":"ﲉ"},{"type":"word","html":"إِلَى","position":5,"translation":"到","code_v4":"ﲊ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْخَيْرِ","position":6,"translation":"善","code_v4":"ﲋ"},{"type":"word","html":"وَيَأْمُرُونَ","position":7,"translation":"并命人","code_v4":"ﲌ"},{"type":"word","html":"بِ<tajweed class=ham_wasl>ٱ</tajweed>لْمَعْرُوفِ","position":8,"translation":"行善","code_v4":"ﲍ"},{"type":"word","html":"وَيَنْهَوْنَ","position":9,"translation":"并禁止","code_v4":"ﲎ"},{"type":"word","html":"عَنِ","position":10,"translation":"于","code_v4":"ﲏ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْمُ<tajweed class=ikhafa>نك</tajweed>َرِ‌ۚ","position":11,"translation":"作恶","code_v4":"ﲐﲑ"},{"type":"word","html":"وَأُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ","position":12,"translation":"这些人","code_v4":"ﲒ"},{"type":"word","html":"هُمُ","position":13,"translation":"他们","code_v4":"ﲓ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْمُفْلِح<tajweed class=madda_permissible>ُو</tajweed>نَ","position":14,"translation":"成功者","code_v4":"ﲔ"},{"type":"ayah_end","html":"١٠٤","code_v4":"ﲕ"}],"meaning":"你们中当有一部分人，导人于至善。并劝善戒恶；这等人，确是成功的。"},{"surah":3,"ayah":105,"tokens":[{"type":"word","html":"وَلَا","position":1,"translation":"不要","code_v4":"ﲖ"},{"type":"word","ht