":"在","code_v4":"ﱐ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّرّ<tajweed class=madda_obligatory>َا</tajweed>ٓءِ","position":4,"translation":"康乐时","code_v4":"ﱑ"},{"type":"word","html":"وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ضَّرّ<tajweed class=madda_obligatory>َا</tajweed>ٓءِ","position":5,"translation":"和艰难时","code_v4":"ﱒ"},{"type":"word","html":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>ظِمِينَ","position":6,"translation":"和抑制者","code_v4":"ﱓ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْغَيْظَ","position":7,"translation":"怒气","code_v4":"ﱔ"},{"type":"word","html":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْعَافِينَ","position":8,"translation":"和宽恕者","code_v4":"ﱕ"},{"type":"word","html":"عَنِ","position":9,"translation":"于","code_v4":"ﱖ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed><tajweed class=ghunnah>نّ</tajweed>َاسِ‌ۗ","position":10,"translation":"人们","code_v4":"ﱗﱘ"},{"type":"word","html":"وَ<tajweed class=ham_wasl>ٱ</tajweed>للَّهُ","position":11,"translation":"而安拉","code_v4":"ﱙ"},{"type":"word","html":"يُحِبُّ","position":12,"translation":"喜爱","code_v4":"ﱚ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْمُحْسِن<tajweed class=madda_permissible>ِي</tajweed>نَ","position":13,"translation":"行善者","code_v4":"ﱛ"},{"type":"ayah_end","html":"١٣٤","code_v4":"ﱜ"}],"meaning":"敬畏的人，在康乐时施舍，在艰难时也施舍，且能抑怒、又能恕人。安拉是喜爱行善者的。"},{"surah":3,"ayah":135,"tokens":[{"type":"word","html":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ","position":1,"translation":"那些人","code_v4":"ﱝ"},{"type":"word","html":"إِذَا","position":2,"translation":"当","code_v4":"ﱞ"},{"type":"word","html":"فَعَلُو<tajweed class=slnt>اْ</tajweed>","position":3,"translation":"他们做了","code_v4":"ﱟ"},{"type":"word","html":"فَ<tajweed class=madda_normal>ـٰ</tajweed>حِشَةً","position":4,"translation":"丑事","c