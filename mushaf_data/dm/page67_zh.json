d class=madda_permissible>ُو</tajweed>نَ","position":23,"translation":"他们知道","code_v4":"ﱳ"},{"type":"ayah_end","html":"١٣٥","code_v4":"ﱴ"}],"meaning":"敬畏者，当他们做了丑事或自欺的时候，他们就会记起安拉，且为自己的罪恶而求饶——除安拉外，谁能赦宥罪恶呢？——他们没有明知故犯地怙恶不悛。"},{"surah":3,"ayah":136,"tokens":[{"type":"word","html":"أُ<tajweed class=slnt>وْ</tajweed>لَ<tajweed class=madda_obligatory>ـٰٓ</tajweed>ئِكَ","position":1,"translation":"这些人","code_v4":"ﱵ"},{"type":"word","html":"جَز<tajweed class=madda_obligatory>َا</tajweed>ٓؤُه<tajweed class=idgham_shafawi>ُم</tajweed>","position":2,"translation":"他们的报酬","code_v4":"ﱶ"},{"type":"word","html":"<tajweed class=idgham_shafawi>م</tajweed>َّغْفِرَ<tajweed class=idgham_ghunnah>ةٌ</tajweed>","position":3,"translation":"赦宥","code_v4":"ﱷ"},{"type":"word","html":"<tajweed class=idgham_ghunnah>م</tajweed>ّ<tajweed class=idgham_wo_ghunnah>ِن</tajweed>","position":4,"translation":"来自","code_v4":"ﱸ"},{"type":"word","html":"<tajweed class=idgham_wo_ghunnah>ر</tajweed>َّبِّهِمْ","position":5,"translation":"他们的养主","code_v4":"ﱹ"},{"type":"word","html":"وَجَ<tajweed class=ghunnah>نّ</tajweed>َ<tajweed class=madda_normal>ـٰ</tajweed><tajweed class=ikhafa>تٌ</tajweed>","position":6,"translation":"和许多乐园","code_v4":"ﱺ"},{"type":"word","html":"<tajweed class=ikhafa>ت</tajweed>َ<tajweed class=qalaqah>جْ</tajweed>رِى","position":7,"translation":"流动","code_v4":"ﱻ"},{"type":"word","html":"مِ<tajweed class=ikhafa>ن</tajweed>","position":8,"translation":"在其下","code_v4":"ﱼ"},{"type":"word","html":"<tajweed class=ikhafa>ت</tajweed>َحْتِهَا","position":9,"translation":"*","code_v4":"ﱽ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْأَنْهَ<tajweed class=madda_normal>ـٰ</tajweed>رُ","position":10,"translation":"诸河","code_v4":"ﱾ"},{"type":"word","html":"خَ<tajweed class=madda_normal>ـٰ</tajweed>لِدِينَ","position":11,"translation":"永居者","code_v4":"ﱿ"},{"type":"word","html":"فِيهَا‌ۚ","position":12,"translation":"在其中","code_v4":"ﲀﲁ"},{"type":"word","html":"وَنِعْمَ","position":13,"translation":"多么美好","code_v4":"ﲂ"},{"type":"word","html":"أَ<tajweed class=qalaqah>جْ</tajweed>رُ","position":14,"translation":"报酬","code_v4":"ﲃ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْعَ<tajweed class=madda_normal>ـٰ</tajweed>مِل<tajweed class=madda_permissible>ِي</tajweed>نَ","position":15,"translation":"行善者的","code_v4":"ﲄ"},{"type":"ayah_end","html":"١٣٦","code_v4":"ﲅ"}],"meaning":"这等人他们的报酬，是从他们的养主发出的赦宥，和下临诸河的乐园，他们得永居其中。遵行者的报酬真优美！"},{"surah":3,"ayah":137,"tokens":[{"type":"word","html":"قَ<tajweed class=qalaqah>دْ</tajweed>","position":1,"translation":"确已","code_v4":"ﲆ"},{"type":"word","html":"خَلَتْ","position":2,"translation":"逝去了","code_v4":"ﲇ"},{"type":"word","html":"مِ<tajweed class=ikhafa>ن</tajweed>","position":3,"translation":"在你们以前","code_v4":"ﲈ"},{"type":"word","html":"<tajweed class=ikhafa>ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِكُمْ","position":4,"translation":"*","code_v4":"ﲉ"},{"type":"word","html":"سُنَ<tajweed class=ikhafa>نٌ</tajweed>","position":5,"translation":"许多常道","code_v4":"ﲊ"},{"type":"word","html":"<tajweed class=ikhafa>ف</tajweed>َسِيرُو<tajweed class=slnt>اْ</tajweed>","position":6,"translation":"所以你们旅行","code_v4":"ﲋ"},{"type":"word","html":"فِى","position":7,"translation":"在","code_v4":"ﲌ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضِ","position":8,"translation":"大地上","code_v4":"ﲍ"},{"type":"word","html":"فَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نظ</tajweed>ُرُو<tajweed class=slnt>اْ</tajweed>","position":9,"translation":"并观察","code_v4":"ﲎ"},{"type":"word","html":"كَيْفَ","position":10,"translation":"怎样","code_v4":"ﲏ"},{"type":"word","html":"كَانَ","position":11,"translation":"曾是","code_v4":"ﲐ"},{"type":"word","html":"عَ<tajweed class=madda_normal>ـٰ</tajweed>قِبَةُ","position":12,"translation":"结局","code_v4":"ﲑ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْمُكَذِّب<tajweed class=madda_permissible>ِي</tajweed>نَ","position":13,"translation":"否认者的","code_v