rmal>َٲ</tajweed>رَٲْٔتُمْ","position":4,"translation":"анан талашып тартыштыңар","code_v4":"ﱱ"},{"type":"word","html":"فِيهَا‌ۖ","position":5,"translation":"анда","code_v4":"ﱲﱳ"},{"type":"word","html":"وَ<tajweed class=ham_wasl>ٱ</tajweed>للَّهُ","position":6,"translation":"жана Аллах","code_v4":"ﱴ"},{"type":"word","html":"مُخْرِ<tajweed class=idgham_ghunnah>جٌ</tajweed>","position":7,"translation":"ачыкка чыгаруучу","code_v4":"ﱵ"},{"type":"word","html":"<tajweed class=idgham_ghunnah>م</tajweed>َّا","position":8,"translation":"эмнени","code_v4":"ﱶ"},{"type":"word","html":"كُ<tajweed class=ikhafa>نت</tajweed>ُمْ","position":9,"translation":"жашырып жаткан болсоңор","code_v4":"ﱷ"},{"type":"word","html":"تَكْتُم<tajweed class=madda_permissible>ُو</tajweed>نَ","position":10,"translation":"*","code_v4":"ﱸ"},{"type":"ayah_end","html":"٧٢","code_v4":"ﱹ"}],"meaning":"(Эй, Исраил урпактары!) Эстегиле, силер бир жанды өлтүрүп, ал жөнүндө (аны ким өлтүргөнү жөнүндө) талашып калдыңар, Аллах болсо, жашырган нерсеңерди ачыкка чыгаруучу."},{"surah":2,"ayah":73,"tokens":[{"type":"word","html":"فَقُلْنَا","position":1,"translation":"ошондо Биз айттык","code_v4":"ﱺ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>ضْرِبُوهُ","position":2,"translation":"аны ургула","code_v4":"ﱻ"},{"type":"word","html":"بِبَعْضِهَا‌ۚ","position":3,"translation":"анын бир бөлүгү менен","code_v4":"ﱼﱽ"},{"type":"word","html":"كَذ<tajweed class=madda_normal>َٲ</tajweed>لِكَ","position":4,"translation":"ушундайча","code_v4":"ﱾ"},{"type":"word","html":"يُحْىِ","position":5,"translation":"тирилтет","code_v4":"ﱿ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>للَّهُ","position":6,"translation":"Аллах","code_v4":"ﲀ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْمَوْتَىٰ","position":7,"translation":"өлүктөрдү","code_v4":"ﲁ"},{"type":"word","html":"وَيُرِيكُمْ","position":8,"translation":"жана силерге көрсөтөт","code_v4":"ﲂ"},{"type":"word","html":"ءَايَ<tajweed class=madda_n