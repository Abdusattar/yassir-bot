anslation":"алардан","code_v4":"ﲹ"},{"type":"word","html":"يَسْمَعُونَ","position":9,"translation":"угушат","code_v4":"ﲺ"},{"type":"word","html":"كَلَ<tajweed class=madda_normal>ـٰ</tajweed>مَ","position":10,"translation":"сөзүн","code_v4":"ﲻ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>للَّهِ","position":11,"translation":"Аллахтын","code_v4":"ﲼ"},{"type":"word","html":"ثُ<tajweed class=ghunnah>مّ</tajweed>َ","position":12,"translation":"андан кийин","code_v4":"ﲽ"},{"type":"word","html":"يُحَرِّفُونَهُ<tajweed class=madda_normal>ۥ</tajweed>","position":13,"translation":"аны бурмалашат","code_v4":"ﲾ"},{"type":"word","html":"م<tajweed class=iqlab>ِنۢ</tajweed>","position":14,"translation":"андан","code_v4":"ﲿ"},{"type":"word","html":"<tajweed class=iqlab>ب</tajweed>َعْدِ","position":15,"translation":"кийин","code_v4":"ﳀ"},{"type":"word","html":"مَا","position":16,"translation":"нерсени","code_v4":"ﳁ"},{"type":"word","html":"عَقَلُوهُ","position":17,"translation":"аны түшүнүшкөн","code_v4":"ﳂ"},{"type":"word","html":"وَهُمْ","position":18,"translation":"жана алар","code_v4":"ﳃ"},{"type":"word","html":"يَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ","position":19,"translation":"билишет","code_v4":"ﳄ"},{"type":"ayah_end","html":"٧٥","code_v4":"ﳅ"}],"meaning":"(Оо, ыймандуулар!) Силер алардын (китеп ээлеринин) ыйманга келүүсүнөн үмүт кыласыңарбы? (Үмүт кылбай эле койгула.) Алардан бир топтору Аллахтын сөздөрүн угуп, акылдары жетип, билип калгандан кийин деле (өз каалоолоруна ылайыктап) өзгөртүп жиберишет."},{"surah":2,"ayah":76,"tokens":[{"type":"word","html":"وَإِذَا","position":1,"translation":"жана качан","code_v4":"ﳆ"},{"type":"word","html":"لَقُو<tajweed class=slnt>اْ</tajweed>","position":2,"translation":"алар жолугушса","code_v4":"ﳇ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ","position":3,"translation":"алар","code_v4":"ﳈ"},{"type":"word","html":"ءَامَنُو<tajweed class=slnt>اْ</tajweed>","position":4,"translation":"ы