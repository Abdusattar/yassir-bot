масал айтишдан ҳеч тортинмайди. Иймонли кишилар унинг ҳақиқатан Парвардигорлари тарафидан эканини биладилар. Кофирлар эса: «Буни мисол қилиш билан Аллоҳ нима демоқчи?» — дейдилар. Бу масал билан (Аллоҳ) кўпларни адаштиради ва кўпларни ҳақ йўлга ҳидоят қилади. Бу масал билан фақат фосиқ кимсаларнигина адаштиради."},{"surah":2,"ayah":27,"tokens":[{"type":"word","html":"ٱلَّذِينَ","position":1,"translation":"ўшаларки","code_v4":"ﲕ"},{"type":"word","html":"يَ<tajweed class=ikhafa>نق</tajweed>ُضُونَ","position":2,"translation":"бузадилар","code_v4":"ﲖ"},{"type":"word","html":"عَهْدَ","position":3,"translation":"аҳдини","code_v4":"ﲗ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>للَّهِ","position":4,"translation":"Аллоҳнинг","code_v4":"ﲘ"},{"type":"word","html":"م<tajweed class=iqlab>ِنۢ</tajweed>","position":5,"translation":"дан кейин","code_v4":"ﲙ"},{"type":"word","html":"<tajweed class=iqlab>ب</tajweed>َعْدِ","position":6,"translation":"*","code_v4":"ﲚ"},{"type":"word","html":"مِيثَ<tajweed class=madda_normal>ـٰ</tajweed>قِه<tajweed class=madda_normal>ِۦ</tajweed>","position":7,"translation":"унинг мисоқи","code_v4":"ﲛ"},{"type":"word","html":"وَيَ<tajweed class=qalaqah>قْ</tajweed>طَعُونَ","position":8,"translation":"ва узадилар","code_v4":"ﲜ"},{"type":"word","html":"م<tajweed class=madda_obligatory>َآ</tajweed>","position":9,"translation":"нарсани","code_v4":"ﲝ"},{"type":"word","html":"أَمَرَ","position":10,"translation":"буюрган","code_v4":"ﲞ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>للَّهُ","position":11,"translation":"Аллоҳ","code_v4":"ﲟ"},{"type":"word","html":"بِه<tajweed class=madda_obligatory>ِۦٓ</tajweed>","position":12,"translation":"у билан","code_v4":"ﲠ"},{"type":"word","html":"أ<tajweed class=idgham_ghunnah>َن</tajweed>","position":13,"translation":"боғланишини","code_v4":"ﲡ"},{"type":"word","html":"<tajweed class=idgham_ghunnah>ي</tajweed>ُوصَلَ","position":14,"translation":"*","code_v4":"ﲢ"},{"type":"word","html":"وَيُفْس