ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ظَّ<tajweed class=madda_normal>ـٰ</tajweed>لِم<tajweed class=madda_permissible>ِي</tajweed>نَ","position":54,"translation":"不义者","code_v4":"ﱺ"},{"type":"ayah_end","html":"٢٤٦","code_v4":"ﱻ"}],"meaning":"你不知道穆萨之后伊司拉仪的后裔中的权贵吗？当时他们对一个同族的先知说：“请你替我们立一个国王，我们就为主道而战斗。”他说：“如果战斗成为你们的定制，你们会不战斗吗？”他们说：“我们已被〔敌人〕逐出故乡，父子离散，我们怎能不为主道而战斗呢？”战斗已成为他们的定制的时候，他们除少数人外，都违背命令了。安拉是全知不义的人的。"},{"surah":2,"ayah":247,"tokens":[{"type":"word","html":"وَقَالَ","position":1,"translation":"说","code_v4":"ﱼ"},{"type":"word","html":"لَهُمْ","position":2,"translation":"对他们","code_v4":"ﱽ"},{"type":"word","html":"نَبِيُّهُمْ","position":3,"translation":"他们的先知","code_v4":"ﱾ"},{"type":"word","html":"إِ<tajweed class=ghunnah>نّ</tajweed>َ","position":4,"translation":"的确","code_v4":"ﱿ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>للَّهَ","position":5,"translation":"安拉","code_v4":"ﲀ"},{"type":"word","html":"قَ<tajweed class=qalaqah>دْ</tajweed>","position":6,"translation":"确已","code_v4":"ﲁ"},{"type":"word","html":"بَعَثَ","position":7,"translation":"立","code_v4":"ﲂ"},{"type":"word","html":"لَكُمْ","position":8,"translation":"为你们","code_v4":"ﲃ"},{"type":"word","html":"طَالُوتَ","position":9,"translation":"塔鲁特","code_v4":"ﲄ"},{"type":"word","html":"مَلِ<tajweed class=ikhafa>كًا‌ۚ</tajweed>","position":10,"translation":"国王","code_v4":"ﲅﲆ"},{"type":"word","html":"<tajweed class=ikhafa>ق</tajweed>َال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed>","position":11,"translation":"他们说","code_v4":"ﲇ"},{"type":"word","html":"أَ<tajweed class=ghunnah>نّ</tajweed>َىٰ","position":12,"translation":"怎么","code_v4":"ﲈ"},{"type":"word","html":"يَكُونُ","position":13,"translation":"会有","code_v4":"ﲉ"},{"type":"word","html":"لَهُ","position":14,"translation":"他","code_v4":"ﲊ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْمُلْكُ","position":15,"translation":"国权","code_v4":"ﲋ"},{"type":"word","html":"عَلَيْنَا","position":16,"tr