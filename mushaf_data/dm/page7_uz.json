ed class=madda_normal>ـٰ</tajweed>بَن<tajweed class=madda_obligatory>ِىٓ</tajweed>","position":1,"translation":"эй авлодлари","code_v4":"ﱠ"},{"type":"word","html":"إِسْر<tajweed class=madda_obligatory>َٲ</tajweed>ٓءِيلَ","position":2,"translation":"Исроил","code_v4":"ﱡ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>ذْكُرُو<tajweed class=slnt>اْ</tajweed>","position":3,"translation":"эсланглар","code_v4":"ﱢ"},{"type":"word","html":"نِعْمَتِىَ","position":4,"translation":"неъматимни","code_v4":"ﱣ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لَّت<tajweed class=madda_obligatory>ِىٓ</tajweed>","position":5,"translation":"қайсики","code_v4":"ﱤ"},{"type":"word","html":"أَنْعَمْتُ","position":6,"translation":"инъом қилдим","code_v4":"ﱥ"},{"type":"word","html":"عَلَيْكُمْ","position":7,"translation":"сизларга","code_v4":"ﱦ"},{"type":"word","html":"وَأَوْفُو<tajweed class=slnt>اْ</tajweed>","position":8,"translation":"ва вафо қилинглар","code_v4":"ﱧ"},{"type":"word","html":"بِعَهْد<tajweed class=madda_obligatory>ِىٓ</tajweed>","position":9,"translation":"аҳдимга","code_v4":"ﱨ"},{"type":"word","html":"أُوفِ","position":10,"translation":"вафо қиламан","code_v4":"ﱩ"},{"type":"word","html":"بِعَهْدِكُمْ","position":11,"translation":"аҳдингизга","code_v4":"ﱪ"},{"type":"word","html":"وَإِيَّ<tajweed class=madda_normal>ـٰ</tajweed>ىَ","position":12,"translation":"ва фақат Мендан","code_v4":"ﱫ"},{"type":"word","html":"فَ<tajweed class=ham_wasl>ٱ</tajweed>رْهَب<tajweed class=madda_permissible>ُو</tajweed>نِ","position":13,"translation":"бас Мендан қўрқинглар","code_v4":"ﱬ"},{"type":"ayah_end","html":"٤٠","code_v4":"ﱭ"}],"meaning":"Эй Бани Исроил, сизга берган неъматларимни эсланг ва Менга берган аҳдингизга вафо қилинг. Мен ҳам сизга берган аҳдимга вафо қилурман. Ва Мендангина қўрқинг!"},{"surah":2,"ayah":41,"tokens":[{"type":"word","html":"وَءَامِنُو<tajweed class=slnt>اْ</tajweed>","position":1,"translation":"ва иймон келтиринглар","code_v4":"ﱮ"},{"type":"