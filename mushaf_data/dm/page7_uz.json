:"فَ<tajweed class=ham_wasl>ٱ</tajweed>تَّق<tajweed class=madda_permissible>ُو</tajweed>نِ","position":18,"translation":"бас қўрқинглар","code_v4":"ﲀ"},{"type":"ayah_end","html":"٤١","code_v4":"ﲁ"}],"meaning":"Ва сиздаги нарсани тасдиқловчи қилиб туширган нарсамга иймон келтиринг! Унга биринчи куфр келтирувчи бўлманг! Менинг оятларимни оз баҳога сотманг ва Мендангина қўрқинг!"},{"surah":2,"ayah":42,"tokens":[{"type":"word","html":"وَلَا","position":1,"translation":"ва на","code_v4":"ﲂ"},{"type":"word","html":"تَلْبِسُو<tajweed class=slnt>اْ</tajweed>","position":2,"translation":"аралаштирманглар","code_v4":"ﲃ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْحَقَّ","position":3,"translation":"ҳақни","code_v4":"ﲄ"},{"type":"word","html":"بِ<tajweed class=ham_wasl>ٱ</tajweed>لْبَ<tajweed class=madda_normal>ـٰ</tajweed>طِلِ","position":4,"translation":"ботил билан","code_v4":"ﲅ"},{"type":"word","html":"وَتَكْتُمُو<tajweed class=slnt>اْ</tajweed>","position":5,"translation":"ва яширманглар","code_v4":"ﲆ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْحَقَّ","position":6,"translation":"ҳақни","code_v4":"ﲇ"},{"type":"word","html":"وَأَ<tajweed class=ikhafa>نت</tajweed>ُمْ","position":7,"translation":"ва ҳолбуки сизлар","code_v4":"ﲈ"},{"type":"word","html":"تَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ","position":8,"translation":"биласизлар","code_v4":"ﲉ"},{"type":"ayah_end","html":"٤٢","code_v4":"ﲊ"}],"meaning":"Ҳақни ботилга аралаштирманг ва ўзингиз билиб туриб ҳақни яширманг!"},{"surah":2,"ayah":43,"tokens":[{"type":"word","html":"وَأَقِيمُو<tajweed class=slnt>اْ</tajweed>","position":1,"translation":"ва қоим қилинглар","code_v4":"ﲋ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّلَ<tajweed class=slnt>و</tajweed><tajweed class=madda_normal>ٲ</tajweed>ةَ","position":2,"translation":"намозни","code_v4":"ﲌ"},{"type":"word","html":"وَءَاتُو<tajweed class=slnt>اْ</tajweed>","position"