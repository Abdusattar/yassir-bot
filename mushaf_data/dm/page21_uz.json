сҳоқ, Яъқубга ва ўша авлодга нозил қилинган нарсаларга, Мусо ва Ийсога берилган нарсаларга ҳамда барча пайғамбарларга Парвардигорлари тарафидан берилган нарсаларга ишондик. Биз улардан бирортасини ажратиб қўймаймиз ва биз У Зотга бўйсунувчилармиз»."},{"surah":2,"ayah":137,"tokens":[{"type":"word","html":"فَإِنْ","position":1,"translation":"бас агар","code_v4":"ﱳ"},{"type":"word","html":"ءَامَنُو<tajweed class=slnt>اْ</tajweed>","position":2,"translation":"иймон келтирсалар","code_v4":"ﱴ"},{"type":"word","html":"بِمِثْلِ","position":3,"translation":"мислига","code_v4":"ﱵ"},{"type":"word","html":"م<tajweed class=madda_obligatory>َآ</tajweed>","position":4,"translation":"нарсани","code_v4":"ﱶ"},{"type":"word","html":"ءَامَ<tajweed class=ikhafa>نت</tajweed><tajweed class=ikhafa_shafawi>ُم</tajweed>","position":5,"translation":"сизлар иймон келтирган","code_v4":"ﱷ"},{"type":"word","html":"<tajweed class=ikhafa_shafawi>ب</tajweed>ِه<tajweed class=madda_normal>ِۦ</tajweed>","position":6,"translation":"у билан","code_v4":"ﱸ"},{"type":"word","html":"فَقَدِ","position":7,"translation":"бас батаҳқиқ","code_v4":"ﱹ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>هْتَدَو<tajweed class=slnt>اْ‌ۖ</tajweed>","position":8,"translation":"ҳидоят топдилар","code_v4":"ﱺﱻ"},{"type":"word","html":"وَّإِ<tajweed class=ikhafa>ن</tajweed>","position":9,"translation":"ва агар","code_v4":"ﱼ"},{"type":"word","html":"<tajweed class=ikhafa>ت</tajweed>َوَلَّوْ<tajweed class=slnt>اْ</tajweed>","position":10,"translation":"юз ўгирсалар","code_v4":"ﱽ"},{"type":"word","html":"فَإِ<tajweed class=ghunnah>نّ</tajweed>َمَا","position":11,"translation":"бас фақатгина","code_v4":"ﱾ"},{"type":"word","html":"هُمْ","position":12,"translation":"улар","code_v4":"ﱿ"},{"type":"word","html":"فِى","position":13,"translation":"ичида","code_v4":"ﲀ"},{"type":"word","html":"شِقَا<tajweed class=ikhafa>قٍ‌ۖ</tajweed>","position":14,"translation":"хилоф","code_v4":"ﲁﲂ"},{"type":"word","html":"<tajweed class=ikh