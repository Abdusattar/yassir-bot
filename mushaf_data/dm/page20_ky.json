 Ибрахим менен (баласы) Ысмайыл экөө Үйдүн (Каабанын) пайдубалын көтөрүп жатып (мындай деп дуба кылышты): “О, Раббибиз! Бизден (ушул ишибизди) кабыл кыла көр! Албетте, Сен Угуучу, Билүүчүсүң!"},{"surah":2,"ayah":128,"tokens":[{"type":"word","html":"رَبَّنَا","position":1,"translation":"Раббибиз","code_v4":"ﱑ"},{"type":"word","html":"وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>جْ</tajweed>عَلْنَا","position":2,"translation":"жана бизди кылгын","code_v4":"ﱒ"},{"type":"word","html":"مُسْلِمَيْنِ","position":3,"translation":"моюн сунуучу","code_v4":"ﱓ"},{"type":"word","html":"لَكَ","position":4,"translation":"сага","code_v4":"ﱔ"},{"type":"word","html":"وَمِ<tajweed class=ikhafa>ن</tajweed>","position":5,"translation":"жана","code_v4":"ﱕ"},{"type":"word","html":"<tajweed class=ikhafa>ذ</tajweed>ُرِّيَّتِن<tajweed class=madda_obligatory>َآ</tajweed>","position":6,"translation":"урпактарыбыздан","code_v4":"ﱖ"},{"type":"word","html":"أُ<tajweed class=ghunnah>مّ</tajweed>َ<tajweed class=idgham_ghunnah>ةً</tajweed>","position":7,"translation":"үммөт","code_v4":"ﱗ"},{"type":"word","html":"<tajweed class=idgham_ghunnah>م</tajweed>ُّسْلِمَ<tajweed class=idgham_wo_ghunnah>ةً</tajweed>","position":8,"translation":"моюн сунуучу","code_v4":"ﱘ"},{"type":"word","html":"<tajweed class=idgham_wo_ghunnah>ل</tajweed>َّكَ","position":9,"translation":"сага","code_v4":"ﱙ"},{"type":"word","html":"وَأَرِنَا","position":10,"translation":"жана бизге көрсөткүн","code_v4":"ﱚ"},{"type":"word","html":"مَنَاسِكَنَا","position":11,"translation":"ибадаттарыбызды","code_v4":"ﱛ"},{"type":"word","html":"وَتُ<tajweed class=qalaqah>بْ</tajweed>","position":12,"translation":"жана тобобузду кабыл кыл","code_v4":"ﱜ"},{"type":"word","html":"عَلَيْن<tajweed class=madda_obligatory>َآ‌ۖ</tajweed>","position":13,"translation":"*","code_v4":"ﱝﱞ"},{"type":"word","html":"إِ<tajweed class=ghunnah>نّ</tajweed>َكَ","position":14,"translation":"чындыгында Сен","code_v4":"ﱟ"},{"type":"word","html":"أَ<tajweed class=ikhafa>نت</tajweed>َ","position":15,"translation":"сен","code_v4":"ﱠ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>تَّوَّابُ","position":16,"translation":"тоболорду кабыл кылуучу","code_v4":"ﱡ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّح<tajweed class=madda_permissible>ِي</tajweed>مُ","position":17,"translation":"ырайымдуу","code_v4":"ﱢ"},{"type":"ayah_end","html":"١٢٨","code_v4":"ﱣ"}],"meaning":"Оо, Раббибиз! Бизди Өзүңө моюн сунуучулардан кыл! Биздин урпактарыбыздан Өзүңө мусулман (моюн сунуучу) үммөт (чыгар!) жана бизге (ажы мезгилинде жасалчу) ибадаттарыбызды үйрөт! Биздин тооболорубузду кабыл кыл! Албетте, Сен тообону кабыл кылуучу, Мээримдүүсүң!"},{"surah":2,"ayah":129,"tokens":[{"type":"word","html":"رَبَّنَا","position":1,"translation":"Раббибиз","code_v4":"ﱤ"},{"type":"word","html":"وَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>بْ</tajweed>عَثْ","position":2,"translation":"жана жибергин","code_v4":"ﱥ"},{"type":"word","html":"فِيهِمْ","position":3,"translation":"алардын арасына","code_v4":"ﱦ"},{"type":"word","html":"رَسُول<tajweed class=idgham_ghunnah>اً</tajweed>","position":4,"translation":"бир элчи","code_v4":"ﱧ"},{"type":"word","html":"<tajweed class=idgham_ghunnah>م</tajweed>ِّنْهُمْ","position":5,"translation":"алардан","code_v4":"ﱨ"},{"type":"word","html":"يَتْلُو<tajweed class=slnt>اْ</tajweed>","position":6,"translation":"окуп берет","code_v4":"ﱩ"},{"type":"word","html":"عَلَيْهِمْ","position":7,"translation":"аларга","code_v4":"ﱪ"},{"type":"word","html":"ءَايَ<tajweed class=madda_normal>ـٰ</tajweed>تِكَ","position":8,"translation":"Сенин аяттарыңды","code_v4":"ﱫ"},{"type":"word","html":"وَيُعَلِّمُهُمُ","position":9,"translation":"жана аларга үйрөтөт","code_v4":"ﱬ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْكِتَ<tajweed class=madda_normal>ـٰ</tajweed>بَ","position":10,"translation":"китепти","code_v4":"ﱭ"},{"type":"word","html":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْحِكْمَةَ","position":11,"translation":"жана даанышмандыкты","code_v4":"ﱮ"},{"type":"word","html":"وَيُزَكِّيهِمْ‌ۚ","position":12,"translation":"жана аларды тазартат","code_v4":"ﱯﱰ"},{"type":"word","html":"إِ<tajweed class=ghunnah>نّ</tajweed>َكَ","position":13,"translation":"чындыгында Сен","code_v4":"ﱱ"},{"type":"word","html":"أَ<tajweed class=ikhafa>نت</tajweed>َ","position":14,"translation":"сен","code_v4":"ﱲ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْعَزِيزُ","position":15,"translation":"Кудуреттүү","code_v4":"ﱳ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْحَك<tajweed class=madda_permissible>ِي</tajweed>مُ","position":16,"translation":"даанышман","code_v4":"ﱴ"},{"type":"ayah_end","html":"١٢٩","code_v4":"ﱵ"}],"meaning":"Оо, Раббибиз! Алардын (урпактарыбыздын) арасынан, аларга Сенин аяттарыңды окуп берүүчү, Китеп жана Даанышмандыкты үйрөтүүчү жана аларды (ширктен ж.б. күнөө иштерден) тазартуучу бир пайгамбар жибер! Албетте, Өзүң Жеңүүчү жана Даанышмансың!”"},{"surah":2,"ayah":130,"tokens":[{"type":"word","html":"وَم<tajweed class=idgham_ghunnah>َن</tajweed>","position":1,"translation":"жана ким","code_v4":"ﱶ"},{"type":"word","html":"<tajweed class=idgham_ghunnah>ي</tajweed>َرْغَبُ","position":2,"translation":"жүз үйрүйт","code_v4":"ﱷ"},{"type":"word","html":"ع<tajweed class=idgham_ghunnah>َن</tajweed>","position":3,"translation":"дан","code_v4":"ﱸ"},{"type":"word","html":"<tajweed class=idgham_ghunnah>م</tajweed>ِّلَّةِ","position":4,"translation":"дини","code_v4":"ﱹ"},{"type":"word","html":"إِ<tajweed class=qalaqah>بْ</tajweed>ر<tajweed class=madda_normal>َٲ</tajweed>هِـ<tajweed class=madda_normal>ـۧ</tajweed>مَ","position":5,"translation":"Ибрахимдин","code_v4":"ﱺ"},{"type":"word","html":"إِلَّا","position":6,"translation":"башка","code_v4":"ﱻ"},{"type":"word","html":"مَ<tajweed class=ikhafa>ن</tajweed>","position":7,"translation":"ким","code_v4":"ﱼ"},{"type":"word","html":"<tajweed class=ikhafa>س</tajweed>َفِهَ","position":8,"translation":"акмак кылган","code_v4":"ﱽ"},{"type":"word","html":"نَفْسَهُ<tajweed class=madda_normal>ۥ</tajweed>‌ۚ","position":9,"translation":"өзүн","code_v4":"ﱾﱿ"},{"type":"word","html":"وَلَقَدِ","position":10,"translation":"жана чындыгында","code_v4":"ﲀ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>صْطَفَيْنَ<tajweed class=madda_normal>ـٰ</tajweed>هُ","position":11,"translation":"Биз аны тандадык","code_v4":"ﲁ"},{"type":"word","html":"فِى","position":12,"translation":"ичинде","code_v4":"ﲂ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>دُّنْيَا‌ۖ","position":13,"translation":"дүйнө","code_v4":"ﲃﲄ"},{"type":"word","html":"وَإِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed>","position":14,"translation":"жана албетте ал","code_v4":"ﲅ"},{"type":"word","html":"فِى","position":15,"translation":"ичинде","code_v4":"ﲆ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْأَخِرَةِ","position":16,"translation":"акыреттин","code_v4":"ﲇ"},{"type":"word","html":"لَمِنَ","position":17,"translation":"албетте катарында","code_v4":"ﲈ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صَّ<tajweed class=madda_normal>ـٰ</tajweed>لِح<tajweed class=madda_permissible>ِي</tajweed>نَ","position":18,"translation":"жакшылардын","code_v4":"ﲉ"},{"type":"ayah_end","html":"١٣٠","code_v4":"ﲊ"}],"meaning":"«Ибрахимдин Дининен наадан адамдар гана баш тартат. Биз Ибрахимди бул дүйнөдө (элдерге жолбашчы кылып) тандап алдык жана ал Акыретте да (жогорку даражалуу) салих адамдардан»."},{"surah":2,"ayah":131,"tokens":[{"type":"word","html":"إِذْ","position":1,"translation":"ошондо","code_v4":"ﲋ"},{"type":"word","html":"قَالَ","position":2,"translation":"айтты","code_v4":"ﲌ"},{"type":"word","html":"لَهُ<tajweed class=madda_normal>ۥ</tajweed>","position":3,"translation":"ага","code_v4":"ﲍ"},{"type":"word","html":"رَبُّهُ<tajweed class=madda_obligatory>ۥٓ</tajweed>","position":4,"translation":"анын Раббиси","code_v4":"ﲎ"},{"type":"word","html":"أَسْلِمْ‌ۖ","position":5,"translation":"моюн сун","code_v4":"ﲏﲐ"},{"type":"word","html":"قَالَ","position":6,"translation":"айтты","code_v4":"ﲑ"},{"type":"word","html":"أَسْلَمْتُ","position":7,"translation":"моюн сундум","code_v4":"ﲒ"},{"type":"word","html":"لِرَبِّ","position":8,"translation":"Раббисине","code_v4":"ﲓ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْعَ<tajweed class=madda_normal>ـٰ</tajweed>لَم<tajweed class=madda_permissible>ِي</tajweed>نَ","position":9,"translation":"ааламдардын","code_v4":"ﲔ"},{"type":"ayah_end","html":"١٣١","code_v4":"ﲕ"}],"meaning":"Эстегин, Раббиси ага “Мусулман бол!” (Өзүмө гана моюн сун!) дегенде, ал (ыклас жана сүйүү менен) “Ааламдардын Раббисине моюн сундум (мусулман болдум)” деди."},{"surah":2,"ayah":132,"tokens":[{"type":"word","html":"وَوَصَّىٰ","position":1,"translation":"жана осуят кылды","code_v4":"ﲖ"},{"type":"word","html":"بِه<tajweed class=madda_obligatory>َآ</tajweed>","position":2,"translation":"аларга","code_v4":"ﲗ"},{"type":"word","html":"إِ<tajweed class=qalaqah>بْ</tajweed>ر<tajweed class=madda_normal>َٲ</tajweed>هِـ<tajweed class=madda_normal>ـۧ</tajweed>مُ","position":3,"translation":"Ибрахим","code_v4":"ﲘ"},{"type":"word","html":"بَنِيهِ","position":4,"translation":"уулдарына","code_v4":"ﲙ"},{"type":"word","html":"وَيَعْقُوبُ","position":5,"translation":"жана Якуб","code_v4":"ﲚ"},{"type":"word","html":"يَ<tajweed class=madda_normal>ـٰ</tajweed>بَنِىَّ","position":6,"translation":"оо уулдарым","code_v4":"ﲛ"},{"type":"word","html":"إِ<tajweed class=ghunnah>نّ</tajweed>َ","position":7,"translation":"чындыгында","code_v4":"ﲜ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>للَّهَ","position":8,"translation":"Аллах","code_v4":"ﲝ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>صْطَفَىٰ","position":9,"tr