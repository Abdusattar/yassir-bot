"code_v4":"ﱮ"}],"meaning":"Ёки улар чақмоқ, момагулдурак, қоронғуликлар билан осмондан қуяётган ёмғир остида яшиндан қўрққанларидан панжаларини қулоқларига тиқиб олган ҳолларида ўлим — ҳалокатдан қочмоқчи бўлиб турган кимсалар кабидирлар. Аллоҳ эса кофирларни ўраб олгувчидир."},{"surah":2,"ayah":20,"tokens":[{"type":"word","html":"يَكَادُ","position":1,"translation":"оз қолади","code_v4":"ﱯ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْبَرْقُ","position":2,"translation":"чақмоқ","code_v4":"ﱰ"},{"type":"word","html":"يَخْطَفُ","position":3,"translation":"тортиб олишга","code_v4":"ﱱ"},{"type":"word","html":"أَ<tajweed class=qalaqah>بْ</tajweed>صَ<tajweed class=madda_normal>ـٰ</tajweed>رَهُمْ‌ۖ","position":4,"translation":"уларнинг кўзларини","code_v4":"ﱲﱳ"},{"type":"word","html":"كُلَّم<tajweed class=madda_obligatory>َآ</tajweed>","position":5,"translation":"ҳар гал","code_v4":"ﱴ"},{"type":"word","html":"أَض<tajweed class=madda_obligatory>َا</tajweed>ٓءَ","position":6,"translation":"ёритса","code_v4":"ﱵ"},{"type":"word","html":"لَه<tajweed class=idgham_shafawi>ُم</tajweed>","position":7,"translation":"уларга","code_v4":"ﱶ"},{"type":"word","html":"<tajweed class=idgham_shafawi>م</tajweed>َّشَوْ<tajweed class=slnt>اْ</tajweed>","position":8,"translation":"юрадилар","code_v4":"ﱷ"},{"type":"word","html":"فِيهِ","position":9,"translation":"унда","code_v4":"ﱸ"},{"type":"word","html":"وَإِذ<tajweed class=madda_obligatory>َآ</tajweed>","position":10,"translation":"ва қачонки","code_v4":"ﱹ"},{"type":"word","html":"أَظْلَمَ","position":11,"translation":"қоронғи бўлса","code_v4":"ﱺ"},{"type":"word","html":"عَلَيْهِمْ","position":12,"translation":"уларга","code_v4":"ﱻ"},{"type":"word","html":"قَامُو<tajweed class=slnt>اْ‌ۚ</tajweed>","position":13,"translation":"туриб қоладилар","code_v4":"ﱼﱽ"},{"type":"word","html":"وَلَوْ","position":14,"translation":"ва агар","code_v4":"ﱾ"},{"type":"word","html":"ش<tajweed class=madda_obligatory>َا</tajweed>ٓءَ","position":15