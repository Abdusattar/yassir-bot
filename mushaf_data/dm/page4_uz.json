":"word","html":"رَبَّكُمُ","position":4,"translation":"Раббингизга","code_v4":"ﲏ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لَّذِى","position":5,"translation":"шундай Зотгаки","code_v4":"ﲐ"},{"type":"word","html":"خَلَقَكُمْ","position":6,"translation":"сизларни яратди","code_v4":"ﲑ"},{"type":"word","html":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ","position":7,"translation":"ва уларки","code_v4":"ﲒ"},{"type":"word","html":"مِ<tajweed class=ikhafa>ن</tajweed>","position":8,"translation":"сизлардан илгари","code_v4":"ﲓ"},{"type":"word","html":"<tajweed class=ikhafa>ق</tajweed>َ<tajweed class=qalaqah>بْ</tajweed>لِكُمْ","position":9,"translation":"*","code_v4":"ﲔ"},{"type":"word","html":"لَعَلَّكُمْ","position":10,"translation":"шоядки сизлар","code_v4":"ﲕ"},{"type":"word","html":"تَتَّق<tajweed class=madda_permissible>ُو</tajweed>نَ","position":11,"translation":"тақво қилсангиз","code_v4":"ﲖ"},{"type":"ayah_end","html":"٢١","code_v4":"ﲗ"}],"meaning":"Эй одамлар, сизларни ва сизлардан олдингиларни яратган Парвардигорингизга ибодат қилинглар. Шоядки, тақво қилсангизлар."},{"surah":2,"ayah":22,"tokens":[{"type":"word","html":"ٱلَّذِى","position":1,"translation":"шундай Зотгаки","code_v4":"ﲘ"},{"type":"word","html":"جَعَلَ","position":2,"translation":"қилди","code_v4":"ﲙ"},{"type":"word","html":"لَكُمُ","position":3,"translation":"сизлар учун","code_v4":"ﲚ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْأَرْضَ","position":4,"translation":"ерни","code_v4":"ﲛ"},{"type":"word","html":"فِر<tajweed class=madda_normal>َٲ</tajweed><tajweed class=idgham_ghunnah>شًا</tajweed>","position":5,"translation":"тўшак","code_v4":"ﲜ"},{"type":"word","html":"<tajweed class=idgham_ghunnah>و</tajweed>َ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّم<tajweed class=madda_obligatory>َا</tajweed>ٓءَ","position":6,"translation":"ва осмонни","code_v4":"ﲝ"},{"type":"word","html":"بِن<tajweed class=madda_obligatory>َا</tajweed>ٓ<ta