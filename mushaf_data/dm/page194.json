{"page":194,"layout":"dm","font_page":194,"font_url":"https://static-cdn.tarteel.ai/qul/fonts/quran_fonts/v4-tajweed/woff2/p194.woff2","surah_names":["التوبة"],"ayahs":[{"surah":9,"ayah":41,"tokens":[{"type":"word","html":"ٱ<tajweed class=ikhafa>نف</tajweed>ِرُو<tajweed class=slnt>اْ</tajweed>","position":1,"translation":"Выступайте","code_v4":"ﱁ"},{"type":"word","html":"خِفَا<tajweed class=idgham_ghunnah>فًا</tajweed>","position":2,"translation":"налегке","code_v4":"ﱂ"},{"type":"word","html":"<tajweed class=idgham_ghunnah>و</tajweed>َثِقَال<tajweed class=idgham_ghunnah>اً</tajweed>","position":3,"translation":"и с тяжестью","code_v4":"ﱃ"},{"type":"word","html":"<tajweed class=idgham_ghunnah>و</tajweed>َجَ<tajweed class=madda_normal>ـٰ</tajweed>هِدُو<tajweed class=slnt>اْ</tajweed>","position":4,"translation":"и боритесь","code_v4":"ﱄ"},{"type":"word","html":"بِأَمْو<tajweed class=madda_normal>َٲ</tajweed>لِكُمْ","position":5,"translation":"своим имуществом","code_v4":"ﱅ"},{"type":"word","html":"وَأَ<tajweed class=ikhafa>نف</tajweed>ُسِكُمْ","position":6,"translation":"и своими душами","code_v4":"ﱆ"},{"type":"word","html":"فِى","position":7,"translation":"на","code_v4":"ﱇ"},{"type":"word","html":"سَبِيلِ","position":8,"translation":"пути","code_v4":"ﱈ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>للَّهِ‌ۚ","position":9,"translation":"Аллаха","code_v4":"ﱉﱊ"},{"type":"word","html":"ذ<tajweed class=madda_normal>َٲ</tajweed>لِكُمْ","position":10,"translation":"Это","code_v4":"ﱋ"},{"type":"word","html":"خَيْ<tajweed class=idgham_wo_ghunnah>رٌ</tajweed>","position":11,"translation":"лучше","code_v4":"ﱌ"},{"type":"word","html":"<tajweed class=idgham_wo_ghunnah>ل</tajweed>َّكُمْ","position":12,"translation":"для вас","code_v4":"ﱍ"},{"type":"word","html":"إِ<tajweed class=ikhafa>ن</tajweed>","position":13,"translation":"если","code_v4":"ﱎ"},{"type":"word","html":"<tajweed class=ikhafa>ك</tajweed>ُ<tajweed class=ikhafa>نت</tajweed>ُمْ","position":14,"translation":"были вы","code_v4":"ﱏ"},{"type":"word","html":"تَعْلَم<tajweed class=madda_permissible>ُو</tajweed>نَ","position":15,"translation":"знающими","code_v4":"ﱐ"},{"type":"ayah_end","html":"٤١","code_v4":"ﱑ"}],"meaning":"Выступайте в поход, легко ли это вам будет или обременительно, и сражайтесь на пути Аллаха своим имуществом и своими душами. Так будет лучше для вас, если бы вы только знали."},{"surah":9,"ayah":42,"tokens":[{"type":"word","html":"لَوْ","position":1,"translation":"Если бы","code_v4":"ﱒ"},{"type":"word","html":"كَانَ","position":2,"translation":"была","code_v4":"ﱓ"},{"type":"word","html":"عَرَ<tajweed class=ikhafa>ضًا</tajweed>","position":3,"translation":"нажива","code_v4":"ﱔ"},{"type":"word","html":"<tajweed class=ikhafa>ق</tajweed>َرِي<tajweed class=idgham_ghunnah>بًا</tajweed>","position":4,"translation":"близкая","code_v4":"ﱕ"},{"type":"word","html":"<tajweed class=idgham_ghunnah>و</tajweed>َسَفَ<tajweed class=ikhafa>رًا</tajweed>","position":5,"translation":"и путь","code_v4":"ﱖ"},{"type":"word","html":"<tajweed class=ikhafa>ق</tajweed>َاصِ<tajweed class=idgham_wo_ghunnah>دًا</tajweed>","position":6,"translation":"умеренный","code_v4":"ﱗ"},{"type":"word","html":"<tajweed class=idgham_wo_ghunnah>ل</tajweed>َّ<tajweed class=ham_wasl>ٱ</tajweed>تَّبَعُوكَ","position":7,"translation":"то последовали бы они за тобой","code_v4":"ﱘ"},{"type":"word","html":"وَلَ<tajweed class=madda_normal>ـٰ</tajweed>ك<tajweed class=iqlab>ِنۢ</tajweed>","position":8,"translation":"но","code_v4":"ﱙ"},{"type":"word","html":"<tajweed class=iqlab>ب</tajweed>َعُدَتْ","position":9,"translation":"далёким оказалось","code_v4":"ﱚ"},{"type":"word","html":"عَلَيْهِمُ","position":10,"translation":"для них","code_v4":"ﱛ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شُّقَّةُ‌ۚ","position":11,"translation":"расстояние","code_v4":"ﱜﱝ"},{"type":"word","html":"وَسَيَحْلِفُونَ","position":12,"translation":"И будут они клясться","code_v4":"ﱞ"},{"type":"word","html":"بِ<tajweed class=ham_wasl>ٱ</tajweed>للَّهِ","position":13,"translation":"Аллахом","code_v4":"ﱟ"},{"type":"word","html":"لَوِ","position":14,"translation":"«Если бы","code_v4":"ﱠ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>سْتَطَعْنَا","position":15,"translation":"могли мы","code_v4":"ﱡ"},{"type":"word","html":"لَخَرَ<tajweed class=qalaqah>جْ</tajweed>نَا","position":16,"translation":"то вышли бы мы","code_v4":"ﱢ"},{"type":"word","html":"مَعَكُمْ","position":17,"translation":"с вами»","code_v4":"ﱣ"},{"type":"word","html":"يُهْلِكُونَ","position":18,"translation":"Губят они","code_v4":"ﱤ"},{"type":"word","html":"أَ<tajweed class=ikhafa>نف</tajweed>ُسَهُمْ","position":19,"translation":"самих себя","code_v4":"ﱥ"},{"type":"word","html":"وَ<tajweed class=ham_wasl>ٱ</tajweed>للَّهُ","position":20,"translation":"и Аллах","code_v4":"ﱦ"},{"type":"word","html":"يَعْلَمُ","position":21,"translation":"знает","code_v4":"ﱧ"},{"type":"word","html":"إِ<tajweed class=ghunnah>نّ</tajweed>َهُمْ","position":22,"translation":"что они","code_v4":"ﱨ"},{"type":"word","html":"لَكَ<tajweed class=madda_normal>ـٰ</tajweed>ذِب<tajweed class=madda_permissible>ُو</tajweed>نَ","position":23,"translation":"лжецы","code_v4":"ﱩ"},{"type":"ayah_end","html":"٤٢","code_v4":"ﱪ"}],"meaning":"Если бы их ожидали близкая нажива и легкая дорога, то они последовали бы за тобой. Но расстояние показалось им дальним, и они будут клясться Аллахом: «Если бы мы могли, то непременно отправились бы с вами». Они губят себя, и Аллах знает, что они являются лжецами."},{"surah":9,"ayah":43,"tokens":[{"type":"word","html":"عَفَا","position":1,"translation":"Простил","code_v4":"ﱫ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>للَّهُ","position":2,"translation":"Аллах","code_v4":"ﱬ"},{"type":"word","html":"عَ<tajweed class=ikhafa>نك</tajweed>َ","position":3,"translation":"тебя!","code_v4":"ﱭ"},{"type":"word","html":"لِمَ","position":4,"translation":"Почему","code_v4":"ﱮ"},{"type":"word","html":"أَذِ<tajweed class=ikhafa>نت</tajweed>َ","position":5,"translation":"разрешил ты","code_v4":"ﱯ"},{"type":"word","html":"لَهُمْ","position":6,"translation":"им","code_v4":"ﱰ"},{"type":"word","html":"حَتَّىٰ","position":7,"translation":"пока не","code_v4":"ﱱ"},{"type":"word","html":"يَتَبَيَّنَ","position":8,"translation":"стали ясны","code_v4":"ﱲ"},{"type":"word","html":"لَكَ","position":9,"translation":"тебе","code_v4":"ﱳ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ","position":10,"translation":"те, которые","code_v4":"ﱴ"},{"type":"word","html":"صَدَقُو<tajweed class=slnt>اْ</tajweed>","position":11,"translation":"были правдивы","code_v4":"ﱵ"},{"type":"word","html":"وَتَعْلَمَ","position":12,"translation":"и не узнал ты","code_v4":"ﱶ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْكَ<tajweed class=madda_normal>ـٰ</tajweed>ذِب<tajweed class=madda_permissible>ِي</tajweed>نَ","position":13,"translation":"лжецов?","code_v4":"ﱷ"},{"type":"ayah_end","html":"٤٣","code_v4":"ﱸ"}],"meaning":"Да простит тебя Аллах! Почему ты разрешил им остаться дома, пока тебе не стало ясно, кто говорит правду, а кто является лжецом?"},{"surah":9,"ayah":44,"tokens":[{"type":"word","html":"لَا","position":1,"translation":"Не","code_v4":"ﱹ"},{"type":"word","html":"يَسْتَــْٔذِنُكَ","position":2,"translation":"просят у тебя дозволения","code_v4":"ﱺ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ","position":3,"translation":"те, которые","code_v4":"ﱻ"},{"type":"word","html":"يُؤْمِنُونَ","position":4,"translation":"веруют","code_v4":"ﱼ"},{"type":"word","html":"بِ<tajweed class=ham_wasl>ٱ</tajweed>للَّهِ","position":5,"translation":"в Аллаха","code_v4":"ﱽ"},{"type":"word","html":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمِ","position":6,"translation":"и в День","code_v4":"ﱾ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْأَخِرِ","position":7,"translation":"Последний","code_v4":"ﱿ"},{"type":"word","html":"أ<tajweed class=idgham_ghunnah>َن</tajweed>","position":8,"translation":"о том, чтобы","code_v4":"ﲀ"},{"type":"word","html":"<tajweed class=idgham_ghunnah>ي</tajweed>ُجَ<tajweed class=madda_normal>ـٰ</tajweed>هِدُو<tajweed class=slnt>اْ</tajweed>","position":9,"translation":"бороться","code_v4":"ﲁ"},{"type":"word","html":"بِأَمْو<tajweed class=madda_normal>َٲ</tajweed>لِهِمْ","position":10,"translation":"своим имуществом","code_v4":"ﲂ"},{"type":"word","html":"وَأَ<tajweed class=ikhafa>نف</tajweed>ُسِهِمْ‌ۗ","position":11,"translation":"и своими душами","code_v4":"ﲃﲄ"},{"type":"word","html":"وَ<tajweed class=ham_wasl>ٱ</tajweed>للَّهُ","position":12,"translation":"И Аллах","code_v4":"ﲅ"},{"type":"word","html":"عَلِي<tajweed class=iqlab>مُۢ</tajweed>","position":13,"translation":"знает","code_v4":"ﲆ"},{"type":"word","html":"<tajweed class=iqlab>ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>لْمُتَّق<tajweed class=madda_permissible>ِي</tajweed>نَ","position":14,"translation":"богобоязненных","code_v4":"ﲇ"},{"type":"ayah_end","html":"٤٤","code_v4":"ﲈ"}],"meaning":"Те, которые веруют в Аллаха и в Последний день, не спрашивают у тебя дозволения на то, чтобы сражаться своим имуществом и своими душами. Ведь Аллах знает богобоязненных."},{"surah":9,"ayah":45,"tokens":[{"type":"word","html":"إِ<tajweed class=ghunnah>نّ</tajweed>َمَا","position":1,"translation":"Лишь","code_v4":"ﲉ"},{"type":"word","html":"يَسْتَــْٔذِنُكَ","position":2,"translation":"просят у тебя дозволения","code_v4":"ﲊ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ","position":3,"translation":"те, которые","code_v4":"ﲋ"},{"type":"word","html":"لَا","position":4,"translation":"не","code_v4":"ﲌ"},{"type":"word","html":"يُؤْمِنُونَ","position":5,"translation":"веруют","code_v4":"ﲍ"},{"type":"word","html":"بِ<tajweed class=ham_wasl>ٱ</tajweed>للَّهِ","position":6,"translation":"в Аллаха","code_v4":"ﲎ"},{"type":"word","html":"وَ<tajweed class=ham_wasl>ٱ</tajweed>لْيَوْمِ","position":7,"translation":"и в День","code_v4":"ﲏ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْأَخِرِ","position":8,"translation":"Последний","code_v4":"ﲐ"},{"type":"word","html":"وَ<tajweed class=ham_wasl>ٱ</tajweed>رْتَابَتْ","position":9,"translation":"и усомнились","code_v4":"ﲑ"},{"type":"word","html":"قُلُوبُهُمْ","position":10,"translation":"их сердца","code_v4":"ﲒ"},{"type":"word","html":"فَهُمْ","position":11,"translation":"и они","code_v4":"ﲓ"},{"type":"word","html":"فِى","position":12,"translation":"в","code_v4":"ﲔ"},{"type":"word","html":"رَيْبِهِمْ","position":13,"translation":"своём сомнении","code_v4":"ﲕ"},{"type":"word","html":"يَتَرَدَّد<tajweed class=madda_permissible>ُو</tajweed>نَ","position":14,"translation":"колеблются","code_v4":"ﲖ"},{"type":"ayah_end","html":"٤٥","code_v4":"ﲗ"}],"meaning":"У тебя просят дозволения остаться дома только те, которые не веруют в Аллаха и в Последний день, сердца которых испытывают сомнение. И по причине своего сомнения они пребывают в замешательстве."},{"surah":9,"ayah":46,"tokens":[{"type":"word","html":"وَلَوْ","position":1,"translation":"А если бы","code_v4":"ﲘﲙ"},{"type":"word","html":"أَرَادُو<tajweed class=slnt>اْ</tajweed>","position":2,"translation":"хотели они","code_v4":"ﲚ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْخُرُوجَ","position":3,"translation":"выйти","code_v4":"ﲛ"},{"type":"word","html":"لَأَعَدُّو<tajweed class=slnt>اْ</tajweed>","position":4,"translation":"то приготовили бы","code_v4":"ﲜ"},{"type":"word","html":"لَهُ<tajweed class=madda_normal>ۥ</tajweed>","position":5,"translation":"к этому","code_v4":"ﲝ"},{"type":"word","html":"عُدَّ<tajweed class=idgham_ghunnah>ةً</tajweed>","position":6,"translation":"снаряжение","code_v4":"ﲞ"},{"type":"word","html":"<tajweed class=idgham_ghunnah>و</tajweed>َلَ<tajweed class=madda_normal>ـٰ</tajweed>كِ<tajweed class=ikhafa>ن</tajweed>","position":7,"translation":"Но","code_v4":"ﲟ"},{"type":"word","html":"<tajweed class=ikhafa>ك<