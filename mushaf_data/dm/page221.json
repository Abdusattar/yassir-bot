anslation":"пришла к вам","code_v4":"ﱡ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْحَقُّ","position":6,"translation":"истина","code_v4":"ﱢ"},{"type":"word","html":"م<tajweed class=idgham_wo_ghunnah>ِن</tajweed>","position":7,"translation":"от","code_v4":"ﱣ"},{"type":"word","html":"<tajweed class=idgham_wo_ghunnah>ر</tajweed>َّبِّكُمْ‌ۖ","position":8,"translation":"вашего Господа","code_v4":"ﱤﱥ"},{"type":"word","html":"فَمَنِ","position":9,"translation":"И кто","code_v4":"ﱦ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>هْتَدَىٰ","position":10,"translation":"пошёл верным путём","code_v4":"ﱧ"},{"type":"word","html":"فَإِ<tajweed class=ghunnah>نّ</tajweed>َمَا","position":11,"translation":"тот лишь","code_v4":"ﱨ"},{"type":"word","html":"يَهْتَدِى","position":12,"translation":"идёт верным путём","code_v4":"ﱩ"},{"type":"word","html":"لِنَفْسِه<tajweed class=madda_normal>ِۦ</tajweed>‌ۖ","position":13,"translation":"для себя","code_v4":"ﱪﱫ"},{"type":"word","html":"وَمَ<tajweed class=ikhafa>ن</tajweed>","position":14,"translation":"а кто","code_v4":"ﱬ"},{"type":"word","html":"<tajweed class=ikhafa>ض</tajweed>َلَّ","position":15,"translation":"заблудился","code_v4":"ﱭ"},{"type":"word","html":"فَإِ<tajweed class=ghunnah>نّ</tajweed>َمَا","position":16,"translation":"тот лишь","code_v4":"ﱮ"},{"type":"word","html":"يَضِلُّ","position":17,"translation":"заблуждается","code_v4":"ﱯ"},{"type":"word","html":"عَلَيْهَا‌ۖ","position":18,"translation":"во вред себе","code_v4":"ﱰﱱ"},{"type":"word","html":"وَم<tajweed class=madda_obligatory>َآ</tajweed>","position":19,"translation":"И не","code_v4":"ﱲ"},{"type":"word","html":"أَنَا۟","position":20,"translation":"я","code_v4":"ﱳ"},{"type":"word","html":"عَلَيْك<tajweed class=ikhafa_shafawi>ُم</tajweed>","position":21,"translation":"над вами","code_v4":"ﱴ"},{"type":"word","html":"<tajweed class=ikhafa_shafawi>ب</tajweed>ِوَك<tajweed class=madda_permissible>ِي</tajweed>لٍ","position":22,"translation":"попечитель»","code_v4":"ﱵ"},{"type":"ayah_end","html":"١٠٨","code_v4":"ﱶ"}],"meaning":"Скажи: «О люди! К вам явилась истина от вашего Господа. Кто следует прямым путем, тот поступает во благо себе, а кто впадает в заблуждение, тот поступает во вред себе. Я не являюсь вашим попечителем и хранителем»."},{"surah":10,"ayah":109,"tokens":[{"type":"word","html":"وَ<tajweed class=ham_wasl>ٱ</tajweed>تَّبِعْ","position":1,"translation":"И следуй","code_v4":"ﱷ"},{"type":"word","html":"مَا","position":2,"translation":"тому, что","code_v4":"ﱸ"},{"type":"word","html":"يُوحَ<tajweed class=madda_obligatory>ىٰٓ</tajweed>","position":3,"translation":"внушается","code_v4":"ﱹ"},{"type":"word","html":"إِلَيْكَ","position":4,"translation":"тебе","code_v4":"ﱺ"},{"type":"word","html":"وَ<tajweed class=ham_wasl>ٱ</tajweed>صْبِرْ","position":5,"translation":"и терпи","code_v4":"ﱻ"},{"type":"word","html":"حَتَّىٰ","position":6,"translation":"пока не","code_v4":"ﱼ"},{"type":"word","html":"يَحْكُمَ","position":7,"translation":"рассудит","code_v4":"ﱽ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>للَّهُ‌ۚ","position":8,"translation":"Аллах","code_v4":"ﱾﱿ"},{"type":"word","html":"وَهُوَ","position":9,"translation":"И Он","code_v4":"ﲀ"},{"type":"word","html":"خَيْرُ","position":10,"translation":"лучший","code_v4":"ﲁ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْحَ<tajweed class=madda_normal>ـٰ</tajweed>كِم<tajweed class=madda_permissible>ِي</tajweed>نَ","position":11,"translation":"из судей","code_v4":"ﲂ"},{"type":"ayah_end","html":"١٠٩","code_v4":"ﲃ"}],"meaning":"Следуй тому, что внушается тебе в откровении, и терпи, пока Аллах не вынесет приговор, ведь Он - Наилучший из судей."},{"surah":11,"ayah":1,"tokens":[{"type":"word","html":"ا<tajweed class=madda_necessary>لٓ</tajweed>ر‌ۚ","position":1,"translation":"Алиф. Лам. Ра","code_v4":"ﲄﲅ"},{"type":"word","html":"كِتَ<tajweed class=madda_normal>ـٰ</tajweed>بٌ","position":2,"translation":"Писание","code_v4":"ﲆ"},{"type":"word