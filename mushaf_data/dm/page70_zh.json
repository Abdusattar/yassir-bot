ass=iqlab>ب</tajweed>ِذَاتِ","position":74,"translation":"内在","code_v4":"ﲒ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>صُّد<tajweed class=madda_permissible>ُو</tajweed>رِ","position":75,"translation":"胸中的","code_v4":"ﲓ"},{"type":"ayah_end","html":"١٥٤","code_v4":"ﲔ"}],"meaning":"在忧患之后，他又降安宁给你们，使你们中一部分人瞌睡；另一部分人则为自身而焦虑，他们像蒙昧时代的人一样，对安拉妄加猜测，他们说：“我们有一点胜利的希望吗？”你说：“一切事情，的确都是安拉所主持的。”他们的心里怀着不敢对你表示的恶意；他们说：“假若我们有一点胜利的希望，我们的同胞不致阵亡在这里。”你说：“假若你们坐在家里，那么，命中注定要阵亡的人，必定外出，走到他们阵亡的地方。〔安拉这样做，〕以便他试验你们的心事，锻炼你们心中的信仰。安拉是全知心事的。”"},{"surah":3,"ayah":155,"tokens":[{"type":"word","html":"إِ<tajweed class=ghunnah>نّ</tajweed>َ","position":1,"translation":"的确","code_v4":"ﲕ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لَّذِينَ","position":2,"translation":"那些人","code_v4":"ﲖ"},{"type":"word","html":"تَوَلَّوْ<tajweed class=slnt>اْ</tajweed>","position":3,"translation":"他们败退了","code_v4":"ﲗ"},{"type":"word","html":"مِ<tajweed class=ikhafa>نك</tajweed>ُمْ","position":4,"translation":"你们中的","code_v4":"ﲘ"},{"type":"word","html":"يَوْمَ","position":5,"translation":"那日","code_v4":"ﲙ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>ْتَقَى","position":6,"translation":"相遇","code_v4":"ﲚ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْجَمْعَانِ","position":7,"translation":"两军","code_v4":"ﲛ"},{"type":"word","html":"إِ<tajweed class=ghunnah>نّ</tajweed>َمَا","position":8,"translation":"只是","code_v4":"ﲜ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>سْتَزَلَّهُمُ","position":9,"translation":"使他们失足","code_v4":"ﲝ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>شَّيْطَ<tajweed class=madda_normal>ـٰ</tajweed>نُ","position":10,"translation":"恶魔","code_v4":"ﲞ"},{"type":"word","html":"بِبَعْضِ","position":11,"translation":"因一部分","code_v4":"ﲟ"},{"type":"word","html":"مَا","position":12,"translation":"那","code_v4":"ﲠ"},{"ty