ation":"чектен чыгышкан","code_v4":"ﱼ"},{"type":"word","html":"مِ<tajweed class=ikhafa>نك</tajweed>ُمْ","position":5,"translation":"силерден","code_v4":"ﱽ"},{"type":"word","html":"فِى","position":6,"translation":"күнүндө","code_v4":"ﱾ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>سَّ<tajweed class=qalaqah>بْ</tajweed>تِ","position":7,"translation":"Ишемби","code_v4":"ﱿ"},{"type":"word","html":"فَقُلْنَا","position":8,"translation":"ошондо Биз айттык","code_v4":"ﲀ"},{"type":"word","html":"لَهُمْ","position":9,"translation":"аларга","code_v4":"ﲁ"},{"type":"word","html":"كُونُو<tajweed class=slnt>اْ</tajweed>","position":10,"translation":"болгула","code_v4":"ﲂ"},{"type":"word","html":"قِرَدَةً","position":11,"translation":"маймылдар","code_v4":"ﲃ"},{"type":"word","html":"خَ<tajweed class=madda_normal>ـٰ</tajweed>سِــٔ<tajweed class=madda_permissible>ِي</tajweed>نَ","position":12,"translation":"кордолгон","code_v4":"ﲄ"},{"type":"ayah_end","html":"٦٥","code_v4":"ﲅ"}],"meaning":"(О, Исраил урпактары!) Силер өзүңөрдөн бир жамааттын ишемби күн жөнүндө чектен чыкканын билдиңер. Биз аларга “Жийиркеничтүү маймылдарга айлангыла» - дедик."},{"surah":2,"ayah":66,"tokens":[{"type":"word","html":"فَجَعَلْنَ<tajweed class=madda_normal>ـٰ</tajweed>هَا","position":1,"translation":"Ошентип Биз аны кылдык","code_v4":"ﲆ"},{"type":"word","html":"نَكَ<tajweed class=madda_normal>ـٰ</tajweed>ل<tajweed class=idgham_wo_ghunnah>اً</tajweed>","position":2,"translation":"сабак болуучу жаза","code_v4":"ﲇ"},{"type":"word","html":"<tajweed class=idgham_wo_ghunnah>ل</tajweed>ِّمَا","position":3,"translation":"ал нерселер үчүн","code_v4":"ﲈ"},{"type":"word","html":"بَيْنَ","position":4,"translation":"анын алдындагы","code_v4":"ﲉ"},{"type":"word","html":"يَدَيْهَا","position":5,"translation":"*","code_v4":"ﲊ"},{"type":"word","html":"وَمَا","position":6,"translation":"жана ал нерселер үчүн","code_v4":"ﲋ"},{"type":"word","html":"خَلْفَهَا","position":7,"translation":"анын артындагы","code_v4":"ﲌ"},{"type":"word","html":"وَمَوْعِظَ<tajweed class=idgham_wo_ghunnah>ةً</tajweed>","position":8,"translation":"жана насаат","code_v4":"ﲍ"},{"type":"word","html":"<tajweed class=idgham_wo_ghunnah>ل</tajweed>ِّلْمُتَّق<tajweed class=madda_permissible>ِي</tajweed>نَ","position":9,"translation":"такыбалар үчүн","code_v4":"ﲎ"},{"type":"ayah_end","html":"٦٦","code_v4":"ﲏ"}],"meaning":"Бул жазаны алардын алдындагы (замандаш) элдерге жана кийинки элдердин бардыгына үлгү, такыба кишилер үчүн сабак-насаат кылдык."},{"surah":2,"ayah":67,"tokens":[{"type":"word","html":"وَإِذْ","position":1,"translation":"Жана ошондо","code_v4":"ﲐ"},{"type":"word","html":"قَالَ","position":2,"translation":"айтты","code_v4":"ﲑ"},{"type":"word","html":"مُوسَىٰ","position":3,"translation":"Муса","code_v4":"ﲒ"},{"type":"word","html":"لِقَوْمِه<tajweed class=madda_obligatory>ِۦٓ</tajweed>","position":4,"translation":"өз коомуна","code_v4":"ﲓ"},{"type":"word","html":"إِ<tajweed class=ghunnah>نّ</tajweed>َ","position":5,"translation":"Чындыгында","code_v4":"ﲔ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>للَّهَ","position":6,"translation":"Аллах","code_v4":"ﲕ"},{"type":"word","html":"يَأْمُرُكُمْ","position":7,"translation":"силерге буюрат","code_v4":"ﲖ"},{"type":"word","html":"أَ<tajweed class=ikhafa>ن</tajweed>","position":8,"translation":"деп","code_v4":"ﲗ"},{"type":"word","html":"<tajweed class=ikhafa>ت</tajweed>َذْبَحُو<tajweed class=slnt>اْ</tajweed>","position":9,"translation":"союшуңарды","code_v4":"ﲘ"},{"type":"word","html":"بَقَرَ<tajweed class=ikhafa>ةً‌ۖ</tajweed>","position":10,"translation":"бир уйду","code_v4":"ﲙﲚ"},{"type":"word","html":"<tajweed class=ikhafa>ق</tajweed>َال<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed>","position":11,"translation":"айтышты","code_v4":"ﲛ"},{"type":"word","html":"أَتَتَّخِذُنَا","position":12,"translation":"бизди шылдың кылып жатасыңбы","code_v4":"ﲜ"},{"type":"word