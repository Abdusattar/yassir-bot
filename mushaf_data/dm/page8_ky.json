nd","html":"٥٣","code_v4":"ﱽ"}],"meaning":"Ошондо, туура жолго түшөөрсүңөр деп Биз Мусага китепти жана Фурканды (жакшылык менен жамандыктын арасын ажыратууну) бердик."},{"surah":2,"ayah":54,"tokens":[{"type":"word","html":"وَإِذْ","position":1,"translation":"Жана ошондо","code_v4":"ﱾ"},{"type":"word","html":"قَالَ","position":2,"translation":"айтты","code_v4":"ﱿ"},{"type":"word","html":"مُوسَىٰ","position":3,"translation":"Муса","code_v4":"ﲀ"},{"type":"word","html":"لِقَوْمِه<tajweed class=madda_normal>ِۦ</tajweed>","position":4,"translation":"коомуна","code_v4":"ﲁ"},{"type":"word","html":"يَ<tajweed class=madda_normal>ـٰ</tajweed>قَوْمِ","position":5,"translation":"Оо коомум","code_v4":"ﲂ"},{"type":"word","html":"إِ<tajweed class=ghunnah>نّ</tajweed>َكُمْ","position":6,"translation":"чындыгында силер","code_v4":"ﲃ"},{"type":"word","html":"ظَلَمْتُمْ","position":7,"translation":"зулумдук кылдыңар","code_v4":"ﲄ"},{"type":"word","html":"أَ<tajweed class=ikhafa>نف</tajweed>ُسَك<tajweed class=ikhafa_shafawi>ُم</tajweed>","position":8,"translation":"өзүңөргө","code_v4":"ﲅ"},{"type":"word","html":"<tajweed class=ikhafa_shafawi>ب</tajweed>ِ<tajweed class=ham_wasl>ٱ</tajweed>تِّخَاذِكُمُ","position":9,"translation":"тутканыңар себептүү","code_v4":"ﲆ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْعِ<tajweed class=qalaqah>جْ</tajweed>لَ","position":10,"translation":"музоону","code_v4":"ﲇ"},{"type":"word","html":"فَتُوب<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed>","position":11,"translation":"ошондуктан тообо кылгыла","code_v4":"ﲈ"},{"type":"word","html":"إِلَىٰ","position":12,"translation":"карай","code_v4":"ﲉ"},{"type":"word","html":"بَارِئِكُمْ","position":13,"translation":"Жаратканыңарга","code_v4":"ﲊ"},{"type":"word","html":"فَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=qalaqah>قْ</tajweed>تُل<tajweed class=madda_obligatory>ُوٓ</tajweed><tajweed class=slnt>اْ</tajweed>","position":14,"translation":"анан өлтүргүлө","code_v4":"ﲋ"},{"type":"word","html":"أَ<tajweed class=ikhafa>نف</tajweed>ُسَكُمْ","position":15,"translation":"өзүңөрдү","code_v4":"ﲌ"},{"type":"word","html":"ذ<tajweed class=madda_normal>َٲ</tajweed>لِكُمْ","position":16,"translation":"ушунуңар","code_v4":"ﲍ"},{"type":"word","html":"خَيْ<tajweed class=idgham_wo_ghunnah>رٌ</tajweed>","position":17,"translation":"жакшыраак","code_v4":"ﲎ"},{"type":"word","html":"<tajweed class=idgham_wo_ghunnah>ل</tajweed>َّكُمْ","position":18,"translation":"силер үчүн","code_v4":"ﲏ"},{"type":"word","html":"عِ<tajweed class=ikhafa>ند</tajweed>َ","position":19,"translation":"алдында","code_v4":"ﲐ"},{"type":"word","html":"بَارِئِكُمْ","position":20,"translation":"Жаратканыңардын","code_v4":"ﲑ"},{"type":"word","html":"فَتَابَ","position":21,"translation":"ошондо Ал силердин тообоңорду кабыл кылды","code_v4":"ﲒ"},{"type":"word","html":"عَلَيْكُمْ‌ۚ","position":22,"translation":"*","code_v4":"ﲓﲔ"},{"type":"word","html":"إِ<tajweed class=ghunnah>نّ</tajweed>َهُ<tajweed class=madda_normal>ۥ</tajweed>","position":23,"translation":"чындыгында Ал","code_v4":"ﲕ"},{"type":"word","html":"هُوَ","position":24,"translation":"Өзү","code_v4":"ﲖ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>تَّوَّابُ","position":25,"translation":"тооболорду кабыл кылуучу","code_v4":"ﲗ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=laam_shamsiyah>ل</tajweed>رَّح<tajweed class=madda_permissible>ِي</tajweed>مُ","position":26,"translation":"Ырайымдуу","code_v4":"ﲘ"},{"type":"ayah_end","html":"٥٤","code_v4":"ﲙ"}],"meaning":"Ошол кезде Муса коомуна айтты: «О, коомум! Силер музоону кудай кылып алууңар менен өзүңөргө зулум кылдыңар! Эми Жаратуучуңарга тобо кылгыла, өзүңөрдү (ыймандуулар каапырларды) өлтүргүлө! Жаратуучуңардын эсебинде ушул силер үчүн жакшыраак. Аллах тобоңорду кабыл кылды! Ал - тоболорду кабыл кылуучу, Мээримдүү!"},{"surah":2,"ayah":55,"tokens":[{"type":"word","html":"وَإِذْ","posit