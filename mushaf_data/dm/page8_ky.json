weed>نَ","position":10,"translation":"карап турдуңар","code_v4":"ﱞ"},{"type":"ayah_end","html":"٥٠","code_v4":"ﱟ"}],"meaning":"Эстегиле: силер үчүн деңизди бөлүп, силерди куткардык жана Фараондун аскерлерин чөктүрүп жибердик. Муну силер көрүп турдуңар."},{"surah":2,"ayah":51,"tokens":[{"type":"word","html":"وَإِذْ","position":1,"translation":"жана ошондо","code_v4":"ﱠ"},{"type":"word","html":"و<tajweed class=madda_normal>َٲ</tajweed>عَ<tajweed class=qalaqah>دْ</tajweed>نَا","position":2,"translation":"Биз убадалаштык","code_v4":"ﱡ"},{"type":"word","html":"مُوسَ<tajweed class=madda_obligatory>ىٰٓ</tajweed>","position":3,"translation":"Муса менен","code_v4":"ﱢ"},{"type":"word","html":"أَرْبَعِينَ","position":4,"translation":"кырк","code_v4":"ﱣ"},{"type":"word","html":"لَيْلَ<tajweed class=ikhafa>ةً</tajweed>","position":5,"translation":"түн","code_v4":"ﱤ"},{"type":"word","html":"<tajweed class=ikhafa>ث</tajweed>ُ<tajweed class=ghunnah>مّ</tajweed>َ","position":6,"translation":"анан","code_v4":"ﱥ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>تَّخَذْتُمُ","position":7,"translation":"силер туттуңар","code_v4":"ﱦ"},{"type":"word","html":"<tajweed class=ham_wasl>ٱ</tajweed>لْعِ<tajweed class=qalaqah>جْ</tajweed>لَ","position":8,"translation":"торпокту","code_v4":"ﱧ"},{"type":"word","html":"م<tajweed class=iqlab>ِنۢ</tajweed>","position":9,"translation":"андан кийин","code_v4":"ﱨ"},{"type":"word","html":"<tajweed class=iqlab>ب</tajweed>َعْدِه<tajweed class=madda_normal>ِۦ</tajweed>","position":10,"translation":"*","code_v4":"ﱩ"},{"type":"word","html":"وَأَ<tajweed class=ikhafa>نت</tajweed>ُمْ","position":11,"translation":"жана силер","code_v4":"ﱪ"},{"type":"word","html":"ظَ<tajweed class=madda_normal>ـٰ</tajweed>لِم<tajweed class=madda_permissible>ُو</tajweed>نَ","position":12,"translation":"залимдер","code_v4":"ﱫ"},{"type":"ayah_end","html":"٥١","code_v4":"ﱬ"}],"meaning":"Биз Муса менен кырк күнгө убадалаштык. Ал кетээри менен силер (билип туруп) өзүңөргө зул